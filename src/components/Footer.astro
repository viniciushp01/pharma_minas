---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, hasWhatsApp } from '../config';
---
<footer class="on-dark bg-footer text-navy-100">
  <div class="mx-auto max-w-[1440px] px-5 py-12 md:px-8 lg:px-[120px] lg:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.1fr_1fr_1.2fr_1fr] lg:gap-16">
      <div class="flex flex-col gap-3">
        <a href="/"><Logo tone="gold" /><span class="sr-only">: página inicial</span></a>
        <p class="max-w-[252px] font-display text-[22px] leading-8 text-navy-200">Importação de Medicamentos</p>
      </div>
      <div class="flex flex-col gap-[10px]">
        <h2 class="font-sans text-xs font-bold uppercase tracking-[.06em] text-gold-400">Contato</h2>
        <a class="flex items-center gap-3 text-sm hover:text-white" href={`mailto:${SITE.email}`}><Icon name="mail" size={20} class="text-gold-400" />{SITE.email}</a>
        <p class="flex items-center gap-3 text-sm">
          <Icon name="call" size={20} class="text-gold-400" />
          {hasWhatsApp ? <a class="hover:text-white" href={`tel:+${SITE.WHATSAPP_NUMBER}`}>{SITE.phoneDisplay}</a> : <span>{SITE.phoneDisplay}</span>}
        </p>
        <a class="flex items-center gap-3 text-sm hover:text-white" href={SITE.instagramUrl} target="_blank" rel="noopener noreferrer"><Icon name="alternate_email" size={20} class="text-gold-400" />{SITE.instagram}<span class="sr-only"> (abre em nova aba)</span></a>
      </div>
      <div class="flex flex-col gap-[10px] text-sm">
        <h2 class="font-sans text-xs font-bold uppercase tracking-[.06em] text-gold-400">Dados da empresa</h2>
        <p>{SITE.legalName}</p>
        <p>CNPJ: {SITE.cnpj}</p>
        <p>Endereço: {SITE.address || '[CONFIRMAR]'}</p>
        <p>Horário: {SITE.hours || '[CONFIRMAR]'}</p>
      </div>
      <div class="flex flex-col gap-[10px] text-sm">
        <h2 class="font-sans text-xs font-bold uppercase tracking-[.06em] text-gold-400">Legal</h2>
        <a class="hover:text-white" href="/politica-de-privacidade">Política de Privacidade (LGPD)</a>
        <a class="hover:text-white" href="/blog">Blog</a>
        <a class="hover:text-white" href="/contato">Contato</a>
      </div>
    </div>
    <hr class="mt-10 border-0 border-t border-navy-600" />
    <p class="mt-6 text-xs text-navy-200">© {new Date().getFullYear()} Pharma Minas. Todos os direitos reservados.</p>
  </div>
</footer>
