---
// Ícones Material Symbols (Outlined, 400) + WhatsApp. Inline para herdar a cor (currentColor).
interface Props { name: string; class?: string; size?: number }
const { name, class: cls = '', size } = Astro.props;
const files = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const raw = files[`../icons/${name}.svg`];
if (!raw) throw new Error(`Ícone não encontrado: ${name}`);
let svg = raw.replace(/ (width|height)="[^"]*"/g, '').replace('<svg ', `<svg aria-hidden="true" focusable="false" ${size ? `width="${size}" height="${size}"` : 'width="1em" height="1em"'} `);
if (!/fill="/.test(svg.split('>')[0])) svg = svg.replace('<svg ', '<svg fill="currentColor" ');
---
<span class={`inline-flex shrink-0 ${cls}`} set:html={svg} />
