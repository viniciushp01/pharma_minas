---
import Logo from './Logo.astro';
import QuoteButton from './QuoteButton.astro';
import Icon from './Icon.astro';
import { NAV } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---
<header id="site-header" class="fixed inset-x-0 top-0 z-40 border-b border-n-200 bg-white">
  <div class="mx-auto flex h-16 max-w-[1440px] items-center justify-between px-5 md:px-8 lg:h-[101px] lg:px-[120px]">
    <a href="/" class="inline-flex"><Logo size="md" class="max-lg:hidden" /><Logo size="sm" class="lg:hidden" /><span class="sr-only">: página inicial</span></a>
    <nav aria-label="Principal" class="hidden items-center gap-8 lg:flex">
      {NAV.map((i) => (
        <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined} class="text-[13px] font-medium leading-[18px] text-navy-800 underline-offset-[10px] decoration-gold-500 decoration-2 hover:underline aria-[current=page]:underline">{i.label}</a>
      ))}
    </nav>
    <QuoteButton size="sm" class="max-lg:hidden" />
    <button type="button" id="menu-toggle" class="grid h-11 w-11 place-items-center rounded-lg text-navy-900 lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menu">
      <Icon name="menu" size={28} class="menu-open" /><Icon name="close" size={28} class="menu-close" />
    </button>
  </div>
  <div id="mobile-menu" hidden class="absolute inset-x-0 top-16 z-40 lg:hidden">
    <div class="fixed inset-0 top-16 bg-navy-900/70" data-menu-overlay></div>
    <nav aria-label="Menu móvel" class="relative max-h-[calc(100svh-64px)] overflow-y-auto bg-white px-5 pb-6 pt-2">
      <ul>
        {NAV.map((i) => (
          <li><a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined} class="flex min-h-14 items-center font-display text-[20px] text-navy-900 aria-[current=page]:text-gold-800" data-menu-link>{i.label}</a></li>
        ))}
      </ul>
      <QuoteButton block class="mt-4" />
    </nav>
  </div>
</header>
<script>
  const header = document.getElementById('site-header')!;
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu')!;
  function set(open: boolean) {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    document.body.classList.toggle('is-locked', open);
  }
  btn.addEventListener('click', () => set(menu.hidden));
  menu.querySelectorAll('[data-menu-overlay],[data-menu-link]').forEach((el) => el.addEventListener('click', () => set(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
  window.matchMedia('(min-width:1024px)').addEventListener('change', (m) => { if (m.matches) set(false); });
  // o botão "Solicitar cotação" do menu abre o modal: fecha o menu antes
  menu.querySelector('[data-open-quote]')?.addEventListener('click', () => set(false));
</script>
