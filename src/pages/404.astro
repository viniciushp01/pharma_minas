---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada | Pharma Minas" description="A página que você procura não existe." noindex>
  <section class="section bg-navy-50">
    <div class="container-x flex min-h-[50vh] flex-col items-start justify-center gap-5">
      <p class="eyebrow">Erro 404</p>
      <h1 class="h-display">Não encontramos esta página</h1>
      <p class="lead max-w-[560px]">O endereço pode ter mudado ou ter sido digitado errado. Volte ao início ou veja os guias do blog.</p>
      <div class="flex flex-col gap-3 sm:flex-row"><a href="/" class="btn btn-gold">Voltar ao início</a><a href="/blog" class="btn btn-ghost">Ver o blog</a></div>
    </div>
  </section>
</Base>
