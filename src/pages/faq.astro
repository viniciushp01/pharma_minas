---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteButton from '../components/QuoteButton.astro';
import { SITE, hasWhatsApp, whatsappHref } from '../config';
import { FAQ_GROUPS } from '../data/faq';

const clean = (t: string) => t.replace(/\s*\[CONFIRMAR[^\]]*\]/g, '').trim();
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: FAQ_GROUPS.flatMap((g) => g.items).map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: clean(i.a) } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Perguntas frequentes', item: `${SITE.url}/faq/` },
    ],
  },
];
---
<Base
  title="Perguntas frequentes sobre importação de medicamentos | Pharma Minas"
  description="Dúvidas comuns sobre como funciona a importação de medicamentos e quais documentos são necessários."
  noindex
  {jsonLd}
>
  <section class="on-dark bg-band py-14 lg:py-28" aria-labelledby="faq-h1">
    <div class="container-x flex flex-col gap-5">
      <nav aria-label="Você está em" class="text-xs leading-4 text-navy-200">
        <ol class="flex items-center gap-2"><li><a href="/" class="underline-offset-2 hover:underline">Início</a></li><li aria-hidden="true">›</li><li aria-current="page" class="text-white">Perguntas frequentes</li></ol>
      </nav>
      <h1 id="faq-h1" class="!text-white max-w-[760px] text-[32px] leading-[40px] lg:text-[56px] lg:leading-[64px]">Perguntas frequentes sobre importação de medicamentos</h1>
      <p class="max-w-[760px] text-lg leading-[30px] text-navy-100">Reunimos as dúvidas mais comuns sobre como funciona a importação e quais documentos são necessários. Se a sua pergunta não estiver aqui, fale com a nossa equipe.</p>
    </div>
  </section>

  <section class="bg-page py-[72px] lg:py-36" aria-label="Perguntas e respostas">
    <div data-reveal class="container-x grid gap-10 lg:grid-cols-[256px_1fr] lg:gap-16">
      <nav aria-labelledby="faq-temas" class="hidden lg:block">
        <div class="sticky top-32 flex flex-col gap-3">
          <p id="faq-temas" class="eyebrow eyebrow-line">Temas</p>
          <ul class="flex flex-col gap-3">
            {FAQ_GROUPS.map((g) => <li><a href={`#${g.id}`} class="block rounded-lg bg-sunken px-4 py-3 text-sm leading-5 text-ink hover:bg-line">{g.title}</a></li>)}
          </ul>
        </div>
      </nav>
      <div class="flex max-w-[840px] flex-col gap-12">
        {FAQ_GROUPS.map((g) => (
          <section aria-labelledby={`h-${g.id}`} class="flex scroll-mt-28 flex-col gap-4" id={g.id}>
            <h2 id={`h-${g.id}`} class="text-[28px] leading-9">{g.title}</h2>
            <div class="flex flex-col">
              {g.items.map((i, idx) => (
                <details class="faq-item group border-b border-rule first:border-t" open={idx === 0}>
                  <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-6 text-[15px] font-semibold leading-6 text-ink [&::-webkit-details-marker]:hidden">
                    <span>{i.q}</span>
                    <Icon name="expand_more" size={24} class="shrink-0 text-icon-step transition-transform group-open:rotate-180" />
                  </summary>
                  <p class="pb-6 text-[15px] leading-6 text-body">{i.a}</p>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-warm-strong py-[72px] lg:py-28" aria-labelledby="faq-cta">
    <div data-reveal class="container-x flex flex-col items-center gap-4 text-center">
      <p class="eyebrow eyebrow-line">Ainda com dúvidas?</p>
      <h2 id="faq-cta" class="h2 h2-lg">Não encontrou a sua pergunta?</h2>
      <p class="lead max-w-[640px]">Conte qual medicamento você procura e nossa equipe responde as dúvidas sobre o seu caso.</p>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4"><QuoteButton /><a href={whatsappHref()} class="btn btn-ghost" data-whatsapp {...(hasWhatsApp ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Consultar no WhatsApp{hasWhatsApp && <span class="sr-only"> (abre em nova aba)</span>}</a></div>
    </div>
  </section>
</Base>
