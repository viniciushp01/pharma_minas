---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import QuoteButton from '../../components/QuoteButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { SITE } from '../../config';

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base
  title="Blog: guias sobre importação de medicamentos | Pharma Minas"
  description="Guias sobre importação de medicamentos baseados em fontes oficiais e estudos publicados: documentos, cadeia fria e terapias aprovadas no exterior."
  jsonLd={[{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    ],
  }]}
>
  <section class="bg-navy-50 py-12 lg:py-16" aria-labelledby="blog-h1">
    <div class="container-x flex flex-col gap-5">
      <nav aria-label="Você está em" class="text-xs leading-4 text-n-600">
        <ol class="flex flex-wrap items-center gap-2"><li><a href="/" class="hover:underline">Início</a></li><li aria-hidden="true">›</li><li aria-current="page">Blog</li></ol>
      </nav>
      <h1 id="blog-h1" class="h-display max-w-[860px]">Guias sobre importação de medicamentos</h1>
      <p class="lead max-w-[760px]">Guias baseados em fontes oficiais e em estudos publicados, com autores e referências citados em cada artigo.</p>
    </div>
  </section>

  <section class="section bg-white" aria-label="Artigos">
    <div class="container-x flex flex-col gap-8">
      <h2 class="sr-only">Artigos</h2>
      <div class="flex flex-wrap items-center gap-3" role="group" aria-label="Filtrar por tema" id="blog-filters">
        <button type="button" data-filter="todos" aria-pressed="true" class="filter-chip">Todos</button>
        {cats.map((c) => <button type="button" data-filter={c} aria-pressed="false" class="filter-chip">{c}</button>)}
        <p id="filter-status" role="status" aria-live="polite" class="sr-only"></p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="blog-grid">
        {posts.map((p) => <div data-cat={p.data.category} class="contents"><BlogCard post={p} /></div>)}
      </div>
    </div>
  </section>

  <section class="section bg-gold-100" aria-labelledby="blog-cta">
    <div class="container-x flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-center">
      <div class="max-w-[640px]">
        <h2 id="blog-cta" class="h2">Precisa de um medicamento que não encontra no Brasil?</h2>
        <p class="lead mt-3">Solicite uma cotação gratuita e acompanhe o pedido do início à entrega.</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:gap-4"><QuoteButton /><WhatsAppButton /></div>
    </div>
  </section>
</Base>

<style is:global>
  .filter-chip { min-height: 44px; padding: 8px 18px; border-radius: 99px; border: 1px solid var(--color-n-500); background: #fff; color: var(--color-navy-900); font-size: 13px; font-weight: 500; cursor: pointer; }
  .filter-chip[aria-pressed='true'] { background: var(--color-navy-900); border-color: var(--color-navy-900); color: #fff; }
  .filter-chip:hover:not([aria-pressed='true']) { background: var(--color-navy-50); }
</style>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('#blog-grid [data-cat]');
  const status = document.getElementById('filter-status')!;
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.filter!;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    let n = 0;
    items.forEach((it) => { const show = f === 'todos' || it.dataset.cat === f; it.hidden = !show; it.style.display = show ? '' : 'none'; if (show) n++; });
    status.textContent = `${n} ${n === 1 ? 'artigo' : 'artigos'}`;
  }));
</script>
