---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogCard from '../../components/BlogCard.astro';
import QuoteButton from '../../components/QuoteButton.astro';
import { SITE, hasWhatsApp, whatsappHref } from '../../config';

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);
const cats = [...new Set(posts.map((p) => p.data.category))];
---
<Base
  title="Blog: guias sobre importação de medicamentos | Pharma Minas"
  description="Guias sobre importação de medicamentos baseados em fontes oficiais e estudos publicados: documentos, cadeia fria e terapias aprovadas no exterior."
  jsonLd={[{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    ],
  }]}
>
  <section class="on-dark bg-band py-14 lg:py-28" aria-labelledby="blog-h1">
    <div class="container-x flex flex-col gap-5">
      <nav aria-label="Você está em" class="text-xs leading-4 text-navy-200">
        <ol class="flex items-center gap-2"><li><a href="/" class="underline-offset-2 hover:underline">Início</a></li><li aria-hidden="true">›</li><li aria-current="page" class="text-white">Blog</li></ol>
      </nav>
      <h1 id="blog-h1" class="!text-white max-w-[760px] text-[32px] leading-[40px] lg:text-[56px] lg:leading-[64px]">Guias sobre importação de medicamentos</h1>
      <p class="max-w-[760px] text-lg leading-[30px] text-navy-100">Guias baseados em fontes oficiais e em estudos publicados, para você entender cada etapa antes de pedir a sua cotação.</p>
    </div>
  </section>

  <section class="bg-page py-12 lg:py-24" aria-label="Artigos">
    <div data-reveal class="container-x flex flex-col gap-8 lg:gap-10">
      <h2 class="sr-only">Artigos</h2>
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
        <div class="flex flex-wrap items-center gap-2 lg:gap-3" role="group" aria-label="Filtrar por tema" id="blog-filters">
          <button type="button" data-filter="todos" aria-pressed="true" class="filter-chip">Todos</button>
          {cats.map((c) => <button type="button" data-filter={c} aria-pressed="false" class="filter-chip">{c}</button>)}
        </div>
        <p id="filter-status" role="status" aria-live="polite" class="text-sm leading-[22px] max-md:sr-only">{posts.length} {posts.length === 1 ? 'artigo' : 'artigos'}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" id="blog-grid">
        {posts.map((p) => <div data-cat={p.data.category} class="contents"><BlogCard post={p} /></div>)}
      </div>
    </div>
  </section>

  <section class="bg-warm-strong py-[72px] lg:py-28" aria-labelledby="blog-cta">
    <div data-reveal class="container-x flex flex-col items-center gap-4 text-center">
      <p class="eyebrow eyebrow-line">Próximo passo</p>
      <h2 id="blog-cta" class="h2 h2-lg">Pronto para pedir a sua cotação?</h2>
      <p class="lead max-w-[640px]">Conte qual medicamento você procura e nossa equipe retorna pelo WhatsApp ou pelo e-mail.</p>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4"><QuoteButton /><a href={whatsappHref()} class="btn btn-ghost" data-whatsapp {...(hasWhatsApp ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Consultar no WhatsApp{hasWhatsApp && <span class="sr-only"> (abre em nova aba)</span>}</a></div>
    </div>
  </section>
</Base>

<style is:global>
  .filter-chip { min-height: 44px; padding: 8px 20px; border-radius: 99px; border: 1px solid var(--pm-line-strong); background: transparent; color: var(--pm-ink); font-size: 13px; font-weight: 500; cursor: pointer; }
  .filter-chip[aria-pressed='true'] { background: var(--pm-chip-navy); border-color: var(--pm-chip-navy); color: var(--pm-on-chip); }
  .filter-chip:hover:not([aria-pressed='true']) { background: var(--pm-tint); }
</style>
<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const items = document.querySelectorAll<HTMLElement>('#blog-grid [data-cat]');
  const status = document.getElementById('filter-status')!;
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const f = chip.dataset.filter!;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    let n = 0;
    items.forEach((it) => { const show = f === 'todos' || it.dataset.cat === f; it.hidden = !show; it.style.display = show ? '' : 'none'; if (show) n++; });
    status.textContent = `${n} ${n === 1 ? 'artigo' : 'artigos'}`;
  }));
</script>
