---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE, hasWhatsApp, whatsappHref } from '../config';
import atendimento from '../assets/photos/contato.jpg';

const canais = [
  { icon: 'call', label: 'Telefone', value: SITE.phone, href: SITE.phoneHref },
  { icon: 'mail', label: 'E-mail', value: SITE.email, href: `mailto:${SITE.email}` },
  { icon: 'instagram', label: 'Instagram', value: SITE.instagram, href: SITE.instagramUrl },
];
---
<Base
  title="Contato e cotação de medicamento importado | Pharma Minas"
  description="Conte qual medicamento você procura e como prefere ser atendido. Retornamos pelo WhatsApp, e-mail ou telefone."
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'Contato', url: `${SITE.url}/contato/` }]}
>
  <section class="on-dark bg-band py-14 lg:py-28" aria-labelledby="contato-h1">
    <div class="container-x grid grid-cols-[minmax(0,1fr)] items-start gap-10 lg:grid-cols-[560px_1fr] lg:gap-20">
      <div class="flex flex-col gap-5 lg:pt-4">
        <nav aria-label="Você está em" class="text-xs leading-4 text-navy-200">
          <ol class="flex items-center gap-2"><li><a href="/" class="underline-offset-2 hover:underline">Início</a></li><li aria-hidden="true">›</li><li aria-current="page" class="text-white">Contato</li></ol>
        </nav>
        <h1 id="contato-h1" class="!text-white text-[32px] leading-[40px] lg:text-[56px] lg:leading-[64px]">Precisa de ajuda para trazer o seu medicamento?</h1>
        <p class="text-lg leading-[30px] text-navy-100">Conte qual medicamento você procura e como prefere ser atendido. Retornamos pelo WhatsApp, e-mail ou telefone em até 1 dia útil.</p>
      </div>
      <div id="cotacao" class="scroll-mt-28 rounded-[20px] bg-surface p-6 shadow-xl sm:p-10">
        <h2 class="sr-only">Formulário de contato</h2>
        <QuoteForm id="contato" twoCols submitLabel="Enviar mensagem" origin="contato" />
      </div>
    </div>
  </section>

  <section class="bg-tint py-[72px] lg:py-36" aria-labelledby="canais-t">
    <div data-reveal class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-8 lg:grid-cols-[536px_1fr] lg:gap-16">
      <div class="photo order-first aspect-[536/520] w-full max-lg:aspect-[350/240]">
        <Image src={atendimento} alt="Mulher sorrindo ao consultar o celular em sua mesa, com um caderno aberto, em um escritório claro" widths={[536, 1072]} sizes="(min-width:1024px) 536px, 100vw" loading="lazy" />
      </div>
      <div class="flex max-w-[616px] flex-col gap-5">
        <p class="eyebrow eyebrow-line">Atendimento</p>
        <h2 id="canais-t" class="h2 h2-lg">Outros canais oficiais de atendimento</h2>
        <p>Escolha o canal que for mais fácil para você. Horário de atendimento: {SITE.hours}.</p>
        <ul class="flex flex-col">
          {canais.map((c) => (
            <li class="flex items-center gap-4 border-b border-rule py-5 first:border-t">
              <Icon name={c.icon} size={20} class="text-icon-step" />
              <div class="flex min-w-0 flex-col [overflow-wrap:anywhere]">
                <span class="text-xs font-medium leading-4 text-body">{c.label}</span>
                {c.href
                  ? <a href={c.href} class="font-semibold text-ink hover:underline" {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{c.value}{c.href.startsWith('http') && <span class="sr-only"> (abre em nova aba)</span>}</a>
                  : <span class="font-semibold text-ink">{c.value}</span>}
              </div>
            </li>
          ))}
        </ul>
        <p class="text-[15px] font-medium text-ink">Ainda com dúvidas? <a href="/faq" class="underline decoration-gold-500 decoration-2 underline-offset-4">Veja as perguntas frequentes.</a></p>
      </div>
    </div>
  </section>
</Base>
