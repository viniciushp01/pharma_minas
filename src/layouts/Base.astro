---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import QuoteModal from '../components/QuoteModal.astro';
import { SITE } from '../config';

interface Props {
  title: string; description: string; image?: string; noindex?: boolean; type?: 'website' | 'article';
  jsonLd?: object[]; /** home: a hero ocupa a tela toda por baixo do header fixo */ heroPage?: boolean;
}
const { title, description, image, noindex, type, jsonLd = [], heroPage = false } = Astro.props;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: SITE.url,
  taxID: SITE.cnpj,
  email: SITE.email,
  sameAs: [SITE.instagramUrl],
  description: 'Assessoria na importação de medicamentos, com acompanhamento do pedido à entrega.',
};
---
<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#000c18" />
    <!-- anti-flash: o site abre no tema escuro; só fica claro se a pessoa escolheu o claro no botão -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('pm-theme') === 'light') document.documentElement.classList.remove('dark');
        } catch (e) {}
        // Movimento: entrada das seções só quando o usuário não pediu menos animação (sem JS, tudo fica visível)
        try { if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-ready'); } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {title} {description} {image} {noindex} {type} jsonLd={[org, ...jsonLd]} />
  </head>
  <body>
    <a href="#conteudo" class="sr-only-focusable fixed left-3 top-3 z-[60] rounded-lg bg-navy-900 px-4 py-3 text-sm font-semibold text-white">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo" tabindex="-1" class={heroPage ? '' : 'pt-16 lg:pt-[101px]'}>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <QuoteModal />
    <script is:inline>
      // Entrada das seções: fade + 12 px em 240 ms, uma vez. As etapas da home também desenham o filete (600 ms).
      (function () {
        var els = document.querySelectorAll('[data-reveal], .steps');
        var show = function (el) { el.classList.add('is-in'); };
        if (!('IntersectionObserver' in window)) { els.forEach(show); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
        }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
